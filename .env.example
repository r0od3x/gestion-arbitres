# Copier en .env puis adapter :  cp .env.example .env

# --- Général ---
ENVIRONMENT=dev
DEBUG=true
DEFAULT_TIMEZONE=Africa/Casablanca
DEFAULT_PHONE_REGION=MA

# --- Base de données ---
# En docker compose, l'hôte est « db ». En local sans Docker, laisser le SQLite ci-dessous.
DATABASE_URL=postgresql+asyncpg://arbitres:arbitres@db:5432/arbitres
# DATABASE_URL=sqlite+aiosqlite:///./gestion_arbitres.db

# --- Redis / file de jobs ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Générer une vraie valeur :  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-longue
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
INVITE_TOKEN_TTL_HOURS=72
COOKIE_SECURE=false          # true obligatoirement en production (HTTPS)
COOKIE_SAMESITE=lax

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Notifications ---
NOTIFICATION_PROVIDER=console        # console | whatsapp_cloud | twilio
NOTIFICATION_MAX_ATTEMPTS=3
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=                 # vérification de signature des webhooks
WHATSAPP_VERIFY_TOKEN=               # défi de vérification du webhook (GET)

# --- Premier administrateur (scripts/seed.py) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe!2026
